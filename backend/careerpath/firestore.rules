rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for strict authentication & authorization
    function isAuthenticated() {
      return request.auth != null;
    }

    function isEmailVerified() {
      // Mandatory email verification requirement:
      // Accounts created via email/password MUST be email_verified.
      // Google Sign-In accounts are automatically marked email_verified by Google.
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Student Profiles Collection
    // Each document ID matches the authenticated Firebase UID exactly
    match /students/{uid} {
      // READ: Allowed ONLY if student is authenticated, email is verified,
      // and requesting their own UID document.
      allow read: if isOwner(uid) && isEmailVerified();

      // CREATE: Allowed ONLY for own UID, verified email, matching UID in body,
      // and matching verified email in body.
      allow create: if isOwner(uid)
                    && isEmailVerified()
                    && request.resource.data.firebase_uid == uid
                    && request.resource.data.email == request.auth.token.email;

      // UPDATE: Allowed ONLY for own UID, verified email, and immutable UID/email.
      allow update: if isOwner(uid)
                    && isEmailVerified()
                    && request.resource.data.firebase_uid == uid
                    && request.resource.data.email == resource.data.email;

      // DELETE: Students cannot delete their profile document directly from client
      // (must go through authenticated API or account deletion flow).
      allow delete: if false;
    }

    // Default deny: Block all other documents / paths by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
