# ==============================================================================
# CareerPath Backend Environment Configuration Template
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit your actual '.env' or secret keys to version control.
# ==============================================================================

# Server Environment
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Allowed CORS Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000

# ------------------------------------------------------------------------------
# Firebase Authentication Configuration (Stage 2)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=your-firebase-project-id
# Path to service account private key JSON file (stored securely outside Git)
FIREBASE_SERVICE_ACCOUNT_PATH=secrets/firebase_service_account.json

# ------------------------------------------------------------------------------
# Supabase PostgreSQL & Storage Configuration (Stage 3 & 4)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
# Server-only Service Role Secret (NEVER expose to Flutter client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Private Resume Bucket Name
SUPABASE_STORAGE_BUCKET=resumes
